# ============================================================
# Mars Mission Control — .gitignore
# ============================================================

# ---------- Dependencies ----------
node_modules/
jspm_packages/
.pnp
.pnp.js

# ---------- Build output ----------
dist/
build/
*.bundle.js
*.bundle.js.map

# ---------- Webpack / bundler caches ----------
.cache/
.webpack/
.parcel-cache/

# ---------- Cypress ----------
# Test artifacts (regenerated on every run — never commit)
cypress/videos/
cypress/screenshots/
cypress/downloads/
tests/e2e/**/__snapshots__/
cypress.env.json

# ---------- Coverage / reports ----------
coverage/
.nyc_output/
*.lcov
test-results/
reports/
*.report.json

# ---------- Environment / secrets ----------
.env
.env.*
!.env.example
*.local
*.secret

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- OS artifacts ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------- Editor / IDE ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.iml
*.swp
*.swo
*~
.project
.classpath
.settings/

# ---------- Runtime data (localStorage is browser-side, but guards) ----------
*.local.json
.localStorage.json
.tmp/
temp/
tmp/

# ---------- Git / packaging artifacts ----------
# The delivered Git bundle is a build product — regenerate, don't commit
*.bundle
mars-mission-control.zip
*.zip
!tests/fixtures/*.zip

# ---------- Misc ----------
.eslintcache
.stylelintcache
.cache-loader/