{
  "name": "mars-mission-control",
  "version": "1.0.0",
  "description": "Mars Mission Control — vanilla JavaScript SPA for mission task management, built with webpack and tested with Cypress.",
  "private": true,
  "license": "UNLICENSED",
  "author": "Thapelo Magqazana",
  "keywords": [
    "spa",
    "vanilla-javascript",
    "webpack",
    "cypress",
    "localstorage",
    "mission-control"
  ],
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10.9.0 <11"
  },
  "main": "src/js/index.js",
  "scripts": {
    "start": "webpack serve --mode development --open",
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "clean": "rimraf dist",
    "pretest:e2e": "npm run build",
    "test": "jest",
    "test:e2e": "cross-env ELECTRON_EXTRA_LAUNCH_ARGS=\"--no-sandbox --disable-dev-shm-usage --disable-gpu\" cypress run",
    "test:e2e:open": "cross-env ELECTRON_EXTRA_LAUNCH_ARGS=\"--no-sandbox --disable-dev-shm-usage --disable-gpu\" cypress open",
    "test:e2e:headless": "cypress run --browser chrome --headless",
    "test:e2e:ci": "cypress run --browser chrome --headless",
    "test:e2e:report": "cross-env CI=true cypress run --browser chrome --headless",
    "verify": "npm run lint:syntax && npm run test && npm run build && npm run test:e2e",
    "lint:syntax": "find src/js -name '*.js' -type f -print0 | xargs -0 -n1 sh -c 'cat \"$0\" | node --check --input-type=module'"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "babel-jest": "^30.5.2",
    "copy-webpack-plugin": "^12.0.2",
    "cross-env": "10.1.0",
    "css-loader": "^6.10.0",
    "cypress": "^14.0.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "mini-css-extract-plugin": "^2.10.2",
    "rimraf": "^5.0.5",
    "style-loader": "^3.3.4",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.2"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Edge versions",
    "last 2 Safari versions"
  ],
  "jest": {
    "projects": [
      {
        "displayName": "node",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/unit/node/**/*.test.js"
        ]
      },
      {
        "displayName": "jsdom",
        "testEnvironment": "jsdom",
        "testMatch": [
          "<rootDir>/tests/unit/jsdom/**/*.test.js"
        ]
      }
    ],
    "collectCoverageFrom": [
      "src/js/store/**/*.js",
      "src/js/events/**/*.js",
      "src/js/views/**/*.js",
      "src/js/utils/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thapelomagqazana/mars-mission-control.git"
  },
  "bugs": {
    "url": "https://github.com/thapelomagqazana/mars-mission-control/issues"
  },
  "homepage": "https://github.com/thapelomagqazana/mars-mission-control#readme"
}
