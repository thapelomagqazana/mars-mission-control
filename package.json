{
  "name": "mars-mission-control",
  "version": "1.0.0",
  "description": "Mars Mission Control — vanilla JavaScript SPA for mission task management, built with webpack and tested with Cypress.",
  "private": true,
  "license": "UNLICENSED",
  "author": "Thapelo Magqazana",
  "keywords": [
    "spa",
    "vanilla-javascript",
    "webpack",
    "cypress",
    "localstorage",
    "mission-control"
  ],
  "engines": {
    "node": ">=18.20.4 <19",
    "npm": ">=10.8.2 <11"
  },
  "main": "src/js/index.js",
  "scripts": {
    "start": "webpack serve --mode development --open",
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "clean": "rimraf dist",
    "pretest:e2e": "npm run build:dev",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:headless": "cypress run --browser chrome --headless",
    "verify": "npm run build && npm run test:e2e",
    "lint:syntax": "node --check src/js/index.js && node --check src/js/app.js && node --check src/js/store/taskStore.js && node --check src/js/views/dashboard.js && node --check src/js/views/taskCard.js && node --check src/js/views/dialog.js && node --check src/js/utils/storage.js && node --check src/js/utils/dom.js"
  },
  "dependencies": {},
  "devDependencies": {
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.2",
    "html-webpack-plugin": "^5.6.0",
    "css-loader": "^6.10.0",
    "style-loader": "^3.3.4",
    "copy-webpack-plugin": "^12.0.2",
    "rimraf": "^5.0.5",
    "cypress": "^13.6.4"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Edge versions",
    "last 2 Safari versions"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thapelomagqazana/mars-mission-control.git"
  },
  "bugs": {
    "url": "https://github.com/thapelomagqazana/mars-mission-control/issues"
  },
  "homepage": "https://github.com/thapelomagqazana/mars-mission-control#readme"
}
